# ---------------------------------------------------------------------------
# ReadMe Realist — environment configuration
#
# Copy to `.env` and fill in. Every value below is validated at startup:
# the process refuses to boot with a malformed key rather than failing on the
# first webhook.
# ---------------------------------------------------------------------------

# --- GitHub credentials ----------------------------------------------------
# How this process proves who it is to GitHub.
#   app    -> the webhook server: sign a JWT, exchange it for an installation
#             token. Needs GITHUB_APP_ID, GITHUB_WEBHOOK_SECRET, and a key.
#   token  -> the CLI (`python -m app.cli`) and the GitHub Action: use a plain
#             token. Needs only GITHUB_TOKEN. No App, no webhook, no PEM.
# Only the selected mode's credentials are required; startup fails if any are
# missing.
GITHUB_AUTH_MODE=app

# --- App mode (GITHUB_AUTH_MODE=app) ---------------------------------------
# From https://github.com/settings/apps/<your-app>
GITHUB_APP_ID=123456

# The webhook secret you set on the GitHub App. Used for HMAC-SHA256
# verification of every incoming payload. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Supply the App private key EITHER inline or by path (exactly one).
# Inline: paste the PEM with literal \n escapes, or use a quoted multi-line value.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.private-key.pem


# --- Token mode (GITHUB_AUTH_MODE=token) -----------------------------------
# A GitHub Actions runner injects this automatically, so you only set it by
# hand for local CLI runs. Any PAT with `repo` scope works.
# GITHUB_TOKEN=ghp_...


# Optional: GitHub Enterprise Server API root. Applies to both modes.
# GITHUB_API_BASE_URL=https://github.example.com/api/v3


# --- Model backend ---------------------------------------------------------
# Which model performs the semantic verification: `gemini` or `anthropic`.
# Only the selected provider's API key is required; startup fails if it's absent.
LLM_PROVIDER=gemini


# --- Gemini (when LLM_PROVIDER=gemini) -------------------------------------
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MAX_OUTPUT_TOKENS=8000
GEMINI_TIMEOUT_SECONDS=300
# Retries on 429/5xx, which Gemini returns under load more often than you'd expect.
GEMINI_MAX_RETRIES=4


# --- Anthropic (when LLM_PROVIDER=anthropic) -------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model + generation settings. Defaults are production-sane; override to tune
# cost. `high` is the API default effort; `low`/`medium` cut spend noticeably.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_EFFORT=high
ANTHROPIC_TIMEOUT_SECONDS=300
ANTHROPIC_MAX_RETRIES=3


# --- Documentation scope ---------------------------------------------------
# Comma-separated globs, resolved against the PR head ref. `**` matches
# across directory separators.
DOCS_GLOBS=README.md,docs/**/*.md

# Guard rails so a large docs tree cannot blow up the context window or bill.
DOCS_MAX_FILES=40
DOCS_MAX_TOTAL_CHARS=200000
DOCS_MAX_FILE_CHARS=60000


# --- Diff handling ---------------------------------------------------------
DIFF_MAX_CHARS=120000

# Lines of unchanged context kept around each hunk when parsing the diff (0-20).
DIFF_CONTEXT_LINES=3

# When true, PRs whose every change normalises to whitespace/formatting churn
# are resolved locally as UP_TO_DATE without an LLM call.
SKIP_LLM_ON_NOISE_ONLY=true


# --- Feedback behaviour ----------------------------------------------------
# Check Run conclusion published when documentation is stale.
#   neutral  -> reports the finding without blocking merge (default)
#   failure  -> hard gate; branch protection can block the merge
#   success  -> advisory comment only
DRIFT_CHECK_CONCLUSION=neutral

POST_PR_COMMENT=true
PUBLISH_CHECK_RUN=true

# Skip draft pull requests entirely.
SKIP_DRAFT_PULL_REQUESTS=true


# --- Server ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
MAX_CONCURRENT_REVIEWS=4


